# ─── Geeves.Life — environment template (beta) ────────────────────────────────
# Copy to .env for local dev. In production (Cloud Run) every value here comes
# from Google Secret Manager via --set-secrets (see docs/gcp-deploy.md).
# NEVER commit a filled-in .env.

# ── Runtime ──
NODE_ENV=production
PORT=8080
APP_URL=https://beta.geeves.life
VITE_APP_URL=https://beta.geeves.life

# ── Database (beta MySQL on GCE, 35.245.41.148:3306) ──
# Format: mysql://USER:PASSWORD@HOST:3306/DBNAME
# Use a dedicated app user (NOT the Kimi read user). Create with:
#   CREATE USER 'geeves_app'@'%' IDENTIFIED BY '<strong-password>';
#   GRANT SELECT,INSERT,UPDATE,DELETE ON geeves_beta.* TO 'geeves_app'@'%';
DATABASE_URL=mysql://geeves_app:__SECRET__@35.245.41.148:3306/geeves_beta?connectionLimit=20

# ── Edits API (Reconciliation Explorer live-writes) ──
EDIT_SECRET=__SECRET__            # shared with the explorer's §9 "Live DB" settings
SYSTEM_CRON_SECRET=__SECRET__     # guards /api/scheduled/* (ical-poll etc.)

# ── Auth / session ──
JWT_SECRET=__SECRET__
OAUTH_SERVER_URL=                 # leave blank for beta unless wiring Manus OAuth
OWNER_OPEN_ID=
VITE_APP_ID=geeves-beta
GOOGLE_CLIENT_ID=                 # if Google OAuth is enabled
GOOGLE_CLIENT_SECRET=__SECRET__

# ── Google Cloud Storage ──
# Buckets (create per docs/gcp-deploy.md): uploads = statements/invoices,
# backups = nightly mysqldump, exports = generated QBO/CSV exports.
GCS_PROJECT_ID=__FILL__           # your GCP project id
GCS_BUCKET_UPLOADS=geeves-beta-uploads
GCS_BUCKET_BACKUPS=geeves-beta-backups
GCS_BUCKET_EXPORTS=geeves-beta-exports
# On Cloud Run, GCS access uses the attached service account (no key file).
# For local dev only, point to a key file:
GOOGLE_APPLICATION_CREDENTIALS=

# ── Legacy Forge storage proxy (current storage backend) ──
# Keep until the GCS storage adapter replaces it; leave blank to disable uploads.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=__SECRET__

# ── Notifications ──
RESEND_API_KEY=__SECRET__
GUARDIAN_ALERT_EMAIL=tarik@geeves.life
GUARDIAN_ENABLED=true
SHADOW_BLOCK_ENGINE_ENABLED=false
