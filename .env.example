# ─── Geeves.Life — environment template (production) ────────────────────────────────
# Copy to .env for local dev. In production (Cloud Run) every value here comes
# from Google Secret Manager via --set-secrets (see docs/gcp-deploy.md).
# NEVER commit a filled-in .env.

# ── Runtime ──
NODE_ENV=production
PORT=8080
APP_URL=https://geeves.life
VITE_APP_URL=https://geeves.life

# ── Database (MySQL on GCE) ──
# Format: mysql://USER:PASSWORD@HOST:3306/DBNAME
# Use a dedicated app user. Create with:
#   CREATE USER 'geeves_app'@'%' IDENTIFIED BY '<strong-password>';
#   GRANT SELECT,INSERT,UPDATE,DELETE ON geeves_live.* TO 'geeves_app'@'%';
DATABASE_URL=mysql://geeves_app:__SECRET__@35.245.41.148:3306/geeves_live?connectionLimit=20

# ── Edits API (Reconciliation Explorer live-writes) ──
EDIT_SECRET=__SECRET__            # shared with the explorer's §9 "Live DB" settings
SYSTEM_CRON_SECRET=__SECRET__     # guards /api/scheduled/* (ical-poll etc.)

# ── Auth / session ──
JWT_SECRET=__SECRET__
OAUTH_SERVER_URL=https://api.manus.im
OWNER_OPEN_ID=
VITE_APP_ID=8LgLCZ74b6FfUR3gEypAGn
GOOGLE_CLIENT_ID=__SECRET__       # OAuth with Google
GOOGLE_CLIENT_SECRET=__SECRET__

# ── Google Cloud Platform ──
GCP_PROJECT_ID=geeves-495802      # your GCP project id
GCP_REGION=us-central1             # GCP region for Vertex AI and other services
GCS_BUCKET_NAME=geeves-live-uploads  # unified bucket for all uploads
GOOGLE_APPLICATION_CREDENTIALS=    # On Cloud Run, uses attached service account

# ── Vertex AI (LLM & Image Generation) ──
# Uses Google Cloud Vertex AI Gemini models and Imagen 3
# No additional configuration needed — uses GCP_PROJECT_ID and service account

# ── Cloud Speech-to-Text ──
# Uses Google Cloud Speech-to-Text API
# No additional configuration needed — uses GCP_PROJECT_ID and service account

# ── Cloud Pub/Sub (Notifications) ──
# Uses Google Cloud Pub/Sub for async notifications
# Topic: geeves-notifications (auto-created if needed)

# ── Notifications ──
RESEND_API_KEY=__SECRET__          # Email service for notifications
GUARDIAN_ALERT_EMAIL=tarik@geeves.life
GUARDIAN_ENABLED=true
SHADOW_BLOCK_ENGINE_ENABLED=false
