# Deploy geeves.life beta to Cloud Run on every push to main.
# Rename to .github/workflows/deploy-cloudrun.yml (needs a PAT with `workflow` scope).
# Auth: Workload Identity Federation — no service-account JSON keys in GitHub.
name: Deploy beta (Cloud Run)
on:
  push:
    branches: [main]
  workflow_dispatch:

env:
  GCP_PROJECT_ID: ${{ vars.GCP_PROJECT_ID }}
  GCP_REGION: us-central1
  AR_REPO: geeves
  SERVICE: geeves-beta

jobs:
  deploy:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@v4

      - uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: ${{ secrets.GCP_WIF_PROVIDER }}
          service_account: ${{ secrets.GCP_DEPLOY_SA }}

      - uses: google-github-actions/setup-gcloud@v2

      - name: Build & push image
        run: |
          gcloud builds submit \
            --tag "$GCP_REGION-docker.pkg.dev/$GCP_PROJECT_ID/$AR_REPO/$SERVICE:${{ github.sha }}"

      - name: Deploy to Cloud Run (secrets from Secret Manager)
        run: |
          gcloud run deploy $SERVICE \
            --image "$GCP_REGION-docker.pkg.dev/$GCP_PROJECT_ID/$AR_REPO/$SERVICE:${{ github.sha }}" \
            --region "$GCP_REGION" --platform managed --allow-unauthenticated \
            --port 8080 --memory 1Gi --min-instances 0 --max-instances 3 \
            --service-account "$SERVICE-runtime@$GCP_PROJECT_ID.iam.gserviceaccount.com" \
            --set-env-vars "NODE_ENV=production,APP_URL=https://beta.geeves.life,VITE_APP_URL=https://beta.geeves.life,VITE_APP_ID=geeves-beta,GCS_PROJECT_ID=$GCP_PROJECT_ID,GCS_BUCKET_UPLOADS=geeves-beta-uploads,GCS_BUCKET_BACKUPS=geeves-beta-backups,GCS_BUCKET_EXPORTS=geeves-beta-exports,GUARDIAN_ENABLED=true,GUARDIAN_ALERT_EMAIL=tarik@geeves.life" \
            --set-secrets "DATABASE_URL=geeves-beta-database-url:latest,EDIT_SECRET=geeves-edit-secret:latest,SYSTEM_CRON_SECRET=geeves-cron-secret:latest,JWT_SECRET=geeves-jwt-secret:latest,RESEND_API_KEY=geeves-resend-api-key:latest"

      - name: Smoke check
        run: |
          URL=$(gcloud run services describe $SERVICE --region $GCP_REGION --format='value(status.url)')
          curl -fsS "$URL/api/health" | grep '"ok":true'
